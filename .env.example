NODE_ENV=production
PORT=3000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Generate with: node -e "console.log(require('bcryptjs').hashSync('CHANGE_ME', 12))"
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
# Long random secret, 64+ chars recommended
ADMIN_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_64_CHARS_MIN
# Optional: original KINGPIN engine backend URL, only if you own/control it
ENGINE_BASE_URL=

# Optional extra admin factor. If set, ADMIN_OTP_SECRET must be a Base32 TOTP secret.
ADMIN_OTP_SECRET=
